#Practical_2
from PIL import Image 
import matplotlib.pyplot as plt 
# Load images
background = Image.open("11.jpg").convert("RGBA") 
overlay = Image.open("12.jpg").convert("RGBA") 
# Resize overlay
overlay = overlay.resize((150, 150))  
# Position
x, y = 50, 50  
# Copy background and paste overlay with transparency
result = background.copy()
result.paste(overlay, (x, y), overlay)  # <-- Added overlay as mask
# Show result
plt.figure(figsize=(8, 8)) 
plt.imshow(result) 
plt.axis("off") 
plt.show()
# Save result
result.save("output.png")  # Save as PNG to preserve transparency




