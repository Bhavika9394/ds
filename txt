import React, { useState } from 'react';
import { View, Text, TextInput, Button } from 'react-native';
import { NavigationContainer } from '@react-navigation/native';
import { createNativeStackNavigator } from '@react-navigation/native-stack';
const Stack = createNativeStackNavigator();
function Home({ navigation }) {
  const [name, setName] = useState('');
  const [course, setCourse] = useState('');
  const box = { borderWidth: 1, borderColor: '#ccc', padding: 10, marginBottom: 12, borderRadius: 8 };
  return (
    <View style={{ flex: 1, justifyContent: 'center', padding: 25 }}>
      <TextInput style={box} placeholder="Student name" value={name} onChangeText={setName} />
      <TextInput style={box} placeholder="Course" value={course} onChangeText={setCourse} />
      <Button title="Open Details" onPress={() => navigation.navigate('Details', { name, course })} />
    </View>
  );
}
function Details({ route }) {
  const { name, course } = route.params;
  return (
    <View style={{ flex: 1, justifyContent: 'center', padding: 25 }}>
      <Text style={{ fontSize: 20 }}>Name: {name}</Text>
      <Text style={{ fontSize: 20 }}>Course: {course}</Text>
    </View>
  );
}
export default function App() {
  return (
    <NavigationContainer>
      <Stack.Navigator>
        <Stack.Screen name="Home" component={Home} />
        <Stack.Screen name="Details" component={Details} />
      </Stack.Navigator>
    </NavigationContainer>
  );
}



