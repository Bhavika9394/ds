#AsyncStorage for Local Storage
npx expo install @react-native-async-storage/async-storage
import React, { useEffect, useState } from 'react';
import { View, Text, TextInput, Button, Alert } from 'react-native';
import { createAsyncStorage } from '@react-native-async-storage/async-storage';
const storage = createAsyncStorage('studentApplication');
const KEY = 'studentProfile';
export default function App() {
  const [name, setName] = useState('');
  const [saved, setSaved] = useState('');
  const load = async () => {
    const v = await storage.getItem(KEY);
    setSaved(v ? JSON.parse(v).name : '');
  };
  const save = async () => {
    if (!name.trim()) return Alert.alert('Error', 'Enter a name.');
    await storage.setItem(KEY, JSON.stringify({ name: name.trim() }));
    setSaved(name.trim()); setName('');
  };
  const remove = async () => { await storage.removeItem(KEY); setSaved(''); };
  useEffect(() => { load(); }, []);
  return (
    <View style={{ flex: 1, padding: 20, paddingTop: 60 }}>
      <TextInput style={{ borderWidth: 1, borderColor: '#ccc', padding: 10, marginBottom: 12, borderRadius: 8 }} placeholder="Enter name" value={name} onChangeText={setName} />
      <Button title="Save" onPress={save} />
      <Button title="Load" onPress={load} />
      <Button title="Remove" color="red" onPress={remove} />
      <Text style={{ fontSize: 20, marginTop: 20 }}>Saved: {saved || 'Nothing saved'}</Text>
    </View>
  );
}


