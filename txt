....7 Stack navigation implementation
import React, { useState } from 'react';
import { View, Text, Button } from 'react-native';

function Home({ onNavigate }) {
  return (
    <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
      <Text style={{ fontSize: 20, marginBottom: 20, color: 'white' }}>Home Screen</Text>
      <Button title="Go" onPress={() => onNavigate('Details')} />
    </View>
  );
}

function Details({ onNavigate }) {
  return (
    <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
      <Text style={{ fontSize: 20, marginBottom: 20, color: 'white' }}>Details Screen</Text>
      <Button title="Back" onPress={() => onNavigate('Home')} />
    </View>
  );
}

export default function App() {
  const [screen, setScreen] = useState('Home');

  return screen === 'Home' ? (
    <Home onNavigate={setScreen} />
  ) : (
    <Details onNavigate={setScreen} />
  );
}


.....8 Tab navigation
import React, { useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity } from 'react-native';

const TABS = [
  { name: 'Home', icon: '🏠', desc: 'Welcome to the home section' },
  { name: 'Profile', icon: '👤', desc: 'Your profile details go here' },
  { name: 'Settings', icon: '⚙️', desc: 'App settings go here' },
];

export default function App() {
  const [active, setActive] = useState(0);
  const tab = TABS[active];

  return (
    <View style={{ flex: 1 }}>
      <View style={styles.container}>
        <Text style={styles.icon}>{tab.icon}</Text>
        <Text style={styles.heading}>{tab.name} Screen</Text>
        <Text style={styles.description}>{tab.desc}</Text>
      </View>

      <View style={styles.tabBar}>
        {TABS.map((t, i) => (
          <TouchableOpacity key={t.name} onPress={() => setActive(i)}>
            <Text style={{ color: i === active ? '#007AFF' : '#888', fontSize: 13 }}>
              {t.name}
            </Text>
          </TouchableOpacity>
        ))}
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, justifyContent: 'center', alignItems: 'center', backgroundColor: '#f5fafe' },
  icon: { fontSize: 55, marginBottom: 15 },
  heading: { fontSize: 20, fontWeight: 'bold', marginBottom: 10 },
  description: { fontSize: 16, textAlign: 'center', paddingHorizontal: 25 },
  tabBar: { flexDirection: 'row', height: 65, justifyContent: 'space-around', alignItems: 'center', borderTopWidth: 1, borderTopColor: '#ddd', backgroundColor: '#fff' },
});



....9 passing data
import React, { useState } from 'react';
import { View, Text, TextInput, Button, StyleSheet } from 'react-native';

export default function App() {
  const [name, setName] = useState('');
  const [course, setCourse] = useState('');
  const [showDetails, setShowDetails] = useState(false);

  if (showDetails) {
    return (
      <View style={styles.container}>
        <View style={styles.card}>
          <Text style={styles.label}>Student Name</Text>
          <Text style={styles.value}>{name || 'Not Provided'}</Text>
          <Text style={styles.label}>Course Name</Text>
          <Text style={styles.value}>{course || 'Not Provided'}</Text>
        </View>
        <Button title="Back" onPress={() => setShowDetails(false)} />
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <TextInput style={styles.input} placeholder="Enter student name" value={name} onChangeText={setName} />
      <TextInput style={styles.input} placeholder="Enter course name" value={course} onChangeText={setCourse} />
      <Button title="Open Details" onPress={() => setShowDetails(true)} />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, padding: 25, justifyContent: 'center' },
  input: { height: 50, paddingHorizontal: 14, marginBottom: 16, backgroundColor: '#fff', borderRadius: 12, elevation: 3 },
  card: { backgroundColor: '#fff', borderRadius: 12, padding: 20, elevation: 3, marginBottom: 16 },
  label: { fontSize: 15, fontWeight: 'bold', marginBottom: 5 },
  value: { fontSize: 18, marginBottom: 20 },
});
