plt.axis('off'); 
plt.show()
# Crop h, w = img.shape[:2] cropped = img[50:h-50, 50:w-50] plt.imshow(cv2.cvtColor(cropped, cv2.COLOR_BGR2RGB)) plt.title('Cropped'); plt.axis('off'); plt.show()
# Rotate by 45 degrees 
M = cv2.getRotationMatrix2D((w/2, h/2), 45, 1) rotated = cv2.warpAffine(img, M, (w, h)) plt.imshow(cv2.cvtColor(rotated, cv2.COLOR_BGR2RGB))
plt.title('Rotated'); 
plt.axis('off'); 
plt.show() 
# Save the image to disk 
cv2.imwrite('saved_image.jpg', img)




